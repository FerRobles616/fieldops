# Local development uses SQLite so onboarding does not require Docker.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./fieldops.db
SECRET_KEY=dev-secret-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=*
STORAGE_PATH=./uploads
UPLOAD_MAX_BYTES=10485760
ALLOWED_PHOTO_TYPES=image/jpeg,image/png,image/webp

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://fieldops:fieldops@localhost:5432/fieldops
